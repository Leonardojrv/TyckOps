# Copia este archivo como .env (en esta misma carpeta). El .env nunca se sube a git.
# Usuario, clave y base deben ser los mismos que pusiste en database/.env.
DATABASE_URL="postgresql://tyckops:cambia-esta-clave@localhost:5432/BDTyckOps?schema=public"

# Contraseñas de los usuarios de prueba que crea `npx prisma db seed` (mínimo 8 caracteres).
SEED_COLABORADOR_PASSWORD=cambia-esta-clave-1
SEED_ADMIN_PASSWORD=cambia-esta-clave-2
