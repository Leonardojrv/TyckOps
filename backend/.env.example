NODE_ENV=development
PORT=3000
# La base solo acepta conexiones cifradas: el backend agrega sslmode=require si falta.
# No uses sslmode=disable ni prefer (ver database/CIFRADO.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tyckops?schema=public
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGIN=*
DEMO_WORKER_EMAIL=colaborador@gamaitaly.cl
DEMO_WORKER_PASSWORD=DemoWorker2026!
DEMO_ADMIN_EMAIL=admin@gamaitaly.cl
DEMO_ADMIN_PASSWORD=DemoAdmin2026!
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_MS=20000
# Logs (winston). LOG_DIR vacío = backend/logs
LOG_LEVEL=info
LOG_DIR=
LOG_RETENCION_DIAS=30
# T11 · Notificaciones push (Firebase). Ruta a la clave de servicio o vacío.
# Vacío = usa backend/firebase-service-account.json; si tampoco existe, el envío
# queda SIMULADO (solo log). La clave es secreta: nunca va a GitHub. Ver docs/FIREBASE.md
FIREBASE_SERVICE_ACCOUNT=
