{
  "info": {
    "name": "TyckOps · Rechazo de ticket con motivo",
    "description": "Prueba manual del rechazo de un ticket por el administrador (RF-07 / RF-17).\n\nAntes de usarla:\n1. Levanta la base (docker compose up -d) y el backend (pnpm dev).\n2. En la pestaña Variables de la colección completa adminEmail, adminPassword y ticketId (un ticket en estado EN_REVISION que NO haya creado ese administrador).\n3. Ejecuta las peticiones en orden. La 1 y la 2 guardan solas el token del administrador.\n\nEn desarrollo el código MFA es fijo (lo muestra la consola del backend; por defecto 123456).\nNo guardes contraseñas reales en esta colección: es para cuentas de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "codigoMfa", "value": "123456" },
    { "key": "ticketId", "value": "" },
    { "key": "mfaToken", "value": "" },
    { "key": "tokenAdmin", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login del administrador (pide código MFA)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y paso MFA', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.step).to.eql('MFA');",
              "});",
              "pm.collectionVariables.set('mfaToken', pm.response.json().data.mfaToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "2. Verificar código MFA (guarda tokenAdmin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y token de sesión', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.token).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('tokenAdmin', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{mfaToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"{{codigoMfa}}\"\n}" },
        "url": "{{baseUrl}}/auth/mfa/verificar"
      }
    },
    {
      "name": "3. Rechazar SIN motivo (debe fallar con 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 DATOS_INVALIDOS', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('DATOS_INVALIDOS');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"estado\": \"RECHAZADO\",\n  \"motivo\": \"   \"\n}" },
        "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/estado"
      }
    },
    {
      "name": "4. Rechazar con motivo corto (debe fallar con 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400: mínimo 100 caracteres', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.message).to.include('100');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"estado\": \"RECHAZADO\",\n  \"motivo\": \"No corresponde.\"\n}" },
        "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/estado"
      }
    },
    {
      "name": "5. Rechazar con motivo válido (200 y motivo en la respuesta)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, RECHAZADO y el motivo viene en la respuesta', () => {",
              "  pm.response.to.have.status(200);",
              "  const ticket = pm.response.json().data.ticket;",
              "  pm.expect(ticket.status).to.eql('RECHAZADO');",
              "  pm.expect(ticket.rejectionReason).to.include('proveedor externo');",
              "  pm.expect(ticket.closedAt).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"RECHAZADO\",\n  \"motivo\": \"El equipo pertenece al proveedor externo de climatización y debe gestionarse por su mesa de soporte, según el contrato vigente.\"\n}"
        },
        "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/estado"
      }
    },
    {
      "name": "6. Ver el detalle del ticket rechazado (motivo guardado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('el motivo quedó guardado en la base', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.ticket.rejectionReason).to.include('proveedor externo');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      }
    }
  ]
}
